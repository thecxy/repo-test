{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "outDir": "./dist/",
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "baseUrl": "./",
        "paths": {
            "@com/*": [
                "./src/components/*"
            ],
            "@src/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        ".eslintrc.js"
        // *** TypeScript文件应该进行类型检查 ***
    ],
    "exclude": [
        "node_modules",
        "build",
        "test",
        "dist",
        "dist/**/*spec.ts",
        "webpack.config.js"
    ],
}
