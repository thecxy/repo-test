{
    "plugins": [
        "react-require",
        "@babel/plugin-proposal-optional-chaining",
        "@babel/plugin-transform-runtime",
        [
            "import",
            {
                "libraryName": "antd",
                "libraryDirectory": "es",
                "style": true
            }
        ]
    ],
    "presets": [
        "@babel/preset-env",
        "@babel/preset-react",
        "@babel/typescript"
    ]
}
